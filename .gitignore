# ── Build output ─────────────────────────────────────────────────────────────
# target/ = Maven + nimbus scratch · _prod/ = deliverables (see the `_` rule below)
target/
out/
build/
dist/
bin/
*.class
*.jar
# ...except the vendored dependencies — see NOTICE
!lib/*.jar

# ── Node tooling (nimbus.cjs) ───────────────────────────────────────────────
node_modules/
sources.txt

# ── The `_` prefix = never committed, without exception ──────────────────────
# _prod/ (deliverables), _private/ (backups, notes, client files — NOT backed up
# by git, keep a copy elsewhere), _ai-* (bundles generated by nimbus.cjs), any
# local _scratch. The authored agent card is AGENTS.md — tracked, no prefix.
_*

# ── Local scratch, anywhere in the tree ──────────────────────────────────────
*.bak
*.orig
*.rej
*.tmp
*.log

# ── Engine artifacts produced while testing ──────────────────────────────────
*.ocd.epub
/hotfolder/

# ── Secrets & local config (the LLM key lives in ~/.jexter/ai.json) ──────────
# .env is TRACKED: it is the project's nimbus configuration (no secrets in it).
# Anything secret or machine-local goes in .env.local / .env.<name>, ignored here.
.env.*
*.pem
*.p12
*.key
ai.json

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
.kotlin

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -- Compiled documentation — ships as a GitHub release asset, never committed --
/*.pdf
