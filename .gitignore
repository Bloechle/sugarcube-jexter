# ── Build output ─────────────────────────────────────────────────────────────
# target/ = Maven + nimbus scratch · _artifacts/ = deliverables (see the `_` rule below)
target/
out/
build/
dist/
bin/
*.class
*.jar
# ...except the vendored dependencies — see NOTICE
!lib/*.jar

# ── Node tooling (nimbus-jexter.cjs) ───────────────────────────────────────────────
node_modules/
sources.txt

# ── The `_` prefix = never committed, without exception ──────────────────────
# _artifacts/ (deliverables), _private/ (backups, notes, client files — NOT backed up
# by git, keep a copy elsewhere), any local _scratch. The authored agent card is
# AGENTS.md and the skill is .claude/skills/ — both tracked, no prefix.
_*

# ── Local scratch, anywhere in the tree ──────────────────────────────────────
*.bak
*.orig
*.rej
*.tmp
*.log
*.javaold

# ── Engine artifacts produced while testing ──────────────────────────────────
*.ocd.epub
/hotfolder/

# ── Secrets & local config (keys live in the environment, never in a file here) ─
# .env is TRACKED: it is the project's nimbus configuration (no secrets in it).
# Anything secret or machine-local goes in .env.local / .env.<name>, ignored here.
.env.*
*.pem
*.p12
*.key

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
.kotlin

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Compiled documentation: a GitHub release asset, never committed ─────────
# (git has no trailing comments: a "# …" after a pattern becomes part of the pattern)
/*.pdf
doc/typst/jexter.pdf
