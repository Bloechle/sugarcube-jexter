# nimbus-jexter.cjs — SugarcubeJexter (the project lives here, the tool stays neutral)
JAR_NAME=sugarcube-jexter.jar
JAR_MAIN=sugarcube.jexter.ui.prism.Prism
APP_NAME=SugarcubeJexter
APP_VERSION=1.1.0
VENDOR=Sugarcube
RELEASE=21
LAUNCHERS=Prism:sugarcube.jexter.ui.prism.Prism,Jexter:sugarcube.jexter.ui.jx.Jexter,PDFInspector:sugarcube.jexter.ui.pdf.PDFInspector
PORT=7333
# The jar's identity (version, commit, build time), read by core.JxBuild — a service says which build it runs.
BUILD_INFO=sugarcube/jexter/build.properties
# The functional gate (node nimbus-jexter.cjs --run=test): compiles, builds the corpus, gates it.
TEST_MAIN=Gates
# The launchers' icon: tracked here, not in the output dir (rm -rf _artifacts IS the clean).
ICON_FILE=res/app.ico
